# Copy to .env (git-ignored) and fill in the token:  cp .env.example .env
KARAVAN_PORT=9998
KARAVAN_REGISTRY_PORT=5555
KARAVAN_GIT_REPOSITORY=https://github.com/m-almeida-p/ms-ml-conv-history-consumer.git
KARAVAN_GIT_USERNAME=m-almeida-p
KARAVAN_GIT_BRANCH=main

# Local only: karavan-db is not published on the host.
KARAVAN_DATASOURCE_USERNAME=karavan
KARAVAN_DATASOURCE_PASSWORD=karavan

# Fine-grained PAT of m-almeida-p, limited to this repo (Contents: read and
# write). Set it in .env, never here.
GITHUB_MALMEIDAP_PAT=
